# Copie para .env na raiz. Sem chave de API o jogo usa o provedor Mock (falas roteirizadas).
# Prioridade: GEMINI_API_KEY > ANTHROPIC_API_KEY > Mock.
GEMINI_API_KEY=
# Padrão: gemini-2.5-flash. Alternativas: gemini-3.5-flash, gemini-flash-latest
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
# Padrão: claude-opus-5. Alternativas mais baratas: claude-sonnet-5, claude-haiku-4-5
CLAUDE_MODEL=claude-opus-5
PORT=3404
